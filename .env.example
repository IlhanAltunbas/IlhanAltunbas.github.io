# DUS Assistant backend'inin uygulama anahtarı (mobil uygulamadakiyle aynı).
# Derlenen sayfada görünür; maliyet backend'deki IP ve günlük limitlerle sınırlı.
# Yerelde .env dosyasına, GitHub'da Settings → Secrets → Actions → DUS_API_KEY olarak koy.
PUBLIC_DUS_API_KEY=
PUBLIC_DUS_API_URL=https://dus-backend.wittysand-a01d0f70.francecentral.azurecontainerapps.io
